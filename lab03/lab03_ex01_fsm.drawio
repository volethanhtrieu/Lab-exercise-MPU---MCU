        </mxCell>
        <mxCell id="eB1" value="B1 pressed" style="endArrow=classic;html=1;fontSize=11;strokeColor=#000000;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="m1" target="m2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="eB2" value="B1 pressed" style="endArrow=classic;html=1;fontSize=11;strokeColor=#000000;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="m2" target="m3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="eB3" value="B1 pressed" style="endArrow=classic;html=1;fontSize=11;strokeColor=#000000;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="m3" target="m4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="eB4" value="B1 pressed / restart traffic FSM" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;fontSize=11;strokeColor=#000000;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="m4" target="m1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="855" y="530"/>
              <mxPoint x="135" y="530"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="lB1" value="no B1 press" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;fontSize=11;strokeColor=#000000;labelBackgroundColor=#FFFFFF;exitX=0.3;exitY=0;entryX=0.7;entryY=0;" edge="1" parent="1" source="m1" target="m1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="105" y="370"/>
              <mxPoint x="165" y="370"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="lB2" value="B2 / temp+1 (99→1)&lt;br&gt;B3 / save temp" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;fontSize=11;strokeColor=#000000;labelBackgroundColor=#FFFFFF;exitX=0.3;exitY=0;entryX=0.7;entryY=0;" edge="1" parent="1" source="m2" target="m2">
