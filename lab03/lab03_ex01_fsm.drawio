<mxfile host="app.diagrams.net">
  <diagram id="ex01" name="Exercise 01 FSM">
    <mxGraphModel dx="1000" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="980" pageHeight="960" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ================= A. BUTTON FSM ================= -->
        <mxCell id="tA" value="&lt;b&gt;A. FSM for each button (debounced input)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="500" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="sA" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="10" y="133" width="14" height="14" as="geometry"/>
        </mxCell>
        <mxCell id="bR" value="RELEASED" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="140" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="bP" value="PRESSED" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="360" y="110" width="140" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="bH" value="PRESSED&lt;br&gt;MORE THAN 1 s" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="660" y="110" width="140" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="eA0" style="endArrow=classic;html=1;strokeColor=#000000;" edge="1" parent="1" source="sA" target="bR">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="eA1" value="is_button_pressed&lt;br&gt;/ output +1" style="endArrow=classic;html=1;fontSize=11;strokeColor=#000000;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="bR" target="bP">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="eA2" value="is_button_pressed_1s" style="endArrow=classic;html=1;fontSize=11;strokeColor=#000000;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="bP" target="bH">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="eA3" value="!is_button_pressed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;fontSize=11;strokeColor=#000000;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.6;entryY=1;" edge="1" parent="1" source="bP" target="bR">
