        <!-- ================= B. MODE FSM ================= -->
        <mxCell id="tB" value="&lt;b&gt;B. FSM for modes (B1 = mode, B2 = increase, B3 = set)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="600" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="sB" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="10" y="443" width="14" height="14" as="geometry"/>
        </mxCell>
        <mxCell id="m1" value="&lt;b&gt;MODE 1&lt;/b&gt;&lt;br&gt;Normal&lt;br&gt;(traffic FSM runs)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="410" width="150" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="m2" value="&lt;b&gt;MODE 2&lt;/b&gt;&lt;br&gt;Edit RED&lt;br&gt;(red LEDs blink 2 Hz)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="410" width="150" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="m3" value="&lt;b&gt;MODE 3&lt;/b&gt;&lt;br&gt;Edit AMBER&lt;br&gt;(amber LEDs blink 2 Hz)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="540" y="410" width="150" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="m4" value="&lt;b&gt;MODE 4&lt;/b&gt;&lt;br&gt;Edit GREEN&lt;br&gt;(green LEDs blink 2 Hz)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="780" y="410" width="150" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="eB0" style="endArrow=classic;html=1;strokeColor=#000000;" edge="1" parent="1" source="sB" target="m1">
