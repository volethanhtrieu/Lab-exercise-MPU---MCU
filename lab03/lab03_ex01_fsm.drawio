          </mxGeometry>
        </mxCell>
        <mxCell id="lB3" value="B2 / temp+1 (99→1)&lt;br&gt;B3 / save temp" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;fontSize=11;strokeColor=#000000;labelBackgroundColor=#FFFFFF;exitX=0.3;exitY=0;entryX=0.7;entryY=0;" edge="1" parent="1" source="m3" target="m3">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="585" y="370"/>
              <mxPoint x="645" y="370"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="lB4" value="B2 / temp+1 (99→1)&lt;br&gt;B3 / save temp" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;fontSize=11;strokeColor=#000000;labelBackgroundColor=#FFFFFF;exitX=0.3;exitY=0;entryX=0.7;entryY=0;" edge="1" parent="1" source="m4" target="m4">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="825" y="370"/>
              <mxPoint x="885" y="370"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="nB" value="Modes 2-4: two 7-seg digits show the temp value (1-99), the other two show the mode number.&lt;br&gt;Rule kept for the traffic cycle: T_red = T_amber + T_green." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="550" width="870" height="40" as="geometry"/>
        </mxCell>

        <!-- ================= C. TRAFFIC FSM ================= -->
