          <mxGeometry x="540" y="730" width="150" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;S3&lt;/b&gt;&lt;br&gt;H: AMBER&lt;br&gt;V: RED" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="780" y="730" width="150" height="80" as="geometry"/>
