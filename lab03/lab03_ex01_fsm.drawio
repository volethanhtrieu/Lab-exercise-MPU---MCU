        <mxCell id="lA1" value="!is_button_pressed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;fontSize=11;strokeColor=#000000;labelBackgroundColor=#FFFFFF;exitX=0.3;exitY=0;entryX=0.7;entryY=0;" edge="1" parent="1" source="bR" target="bR">
